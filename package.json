{
  "name": "dsh-codex-context",
  "version": "0.1.2",
  "description": "Codex-style lossless-retrieval context manager for the DeepSeek Harness: token-budgeted sliding window, persistent working notes, and cold-history search over the append-only session log",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "pnpm run build"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "codex",
    "context-management",
    "sliding-window",
    "compaction",
    "lossless-retrieval"
  ],
  "author": "Francisco Pizarro <francisco_p@outlook.com> (https://github.com/dvaJi)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvaJi/dsh-codex-context.git"
  },
  "bugs": {
    "url": "https://github.com/dvaJi/dsh-codex-context/issues"
  },
  "homepage": "https://github.com/dvaJi/dsh-codex-context#readme",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-compaction": "*",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-token-meter": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction-tool-result-pruner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
